PORT=3002

DATABASE_URL=postgres://postgres:postgres@localhost:5432/safetrust_v2

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_CONTRACT_ID=REPLACE_WITH_DEPLOYED_CONTRACT_ID

# how often (ms) the indexer polls for new contract events
INDEXER_POLL_INTERVAL_MS=5000

# mock (default): deterministic in-memory fixture events, no RPC needed
# live: real server.getEvents() calls against SOROBAN_RPC_URL/ESCROW_CONTRACT_ID
INDEXER_MODE=mock

# shared secret for HMAC-signing POST /webhooks/keeper-ping requests
KEEPER_WEBHOOK_SECRET=replace-with-a-random-secret

# optional: POSTed to on escrow_funded / dispute_opened / dispute_resolved.
# Unset disables notifications entirely (default).
NOTIFICATIONS_WEBHOOK_URL=

# global rate limit window and request cap (defaults: 60000ms / 120 requests)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# optional, comma-separated allowed origins. Unset = allow all (reflects
# the request origin) -- fine for a public wallet-auth API in dev, tighten
# for production.
CORS_ORIGIN=

# GET /indexer/status reports stale:true once the cursor hasn't advanced
# for longer than this (default: 600000ms / 10 minutes)
INDEXER_STALE_THRESHOLD_MS=600000

# how long a GET /auth/challenge nonce stays valid (default: 300000ms / 5 minutes)
AUTH_NONCE_TTL_MS=300000
